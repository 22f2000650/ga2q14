{
  "version": 2,
  "builds": [
    {
      "src": "api/latency.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/latency",
      "methods": ["OPTIONS"],
      "dest": "api/latency.py",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    },
    {
      "src": "/api/latency",
      "dest": "api/latency.py",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
      }
    }
  ]
}